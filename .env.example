DATABASE_URL=your_supabase_connection_string
JWT_SECRET=generate_a_long_random_secret
NODE_ENV=production
FRONTEND_URLS=

# Bootstrap the two administrator accounts in Render.
# Put the real values in Render Environment Variables only.
ADMIN1_NAME=
ADMIN1_EMAIL=
ADMIN1_PASSWORD=
ADMIN2_NAME=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=

# Password-reset delivery. Configure only in local secret storage or Render.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_ORIGIN=https://your-frontend.example.com
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Demo seed safety: use only with an isolated PostgreSQL database.
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=
